@startuml IMTox

hide empty members

class NewsReport {
    - title: String
    - content: String
    - createdAt: DateTime
    - publishedAt: DateTime
    - updateAt: DateTime
    - numberOfViews: Integer
}

class ReportTag {
    - name: String
}

enum ReportState {
    DRAFT
    PUBLISHED
}

NewsReport "0..*" --> "0..*" ReportTag : has
NewsReport --> "1" ReportState : has

class User {
    - login: String
    - password: String
    - personalInformations: Dict
    - preferences: Dict
}

enum UserRole {
    ADMIN
    REPORTER
    READER
}

enum UserState {
    ACTIVE
    BANNED
    DELETED
}

User --> "1" UserRole : has
User --> "1" UserState : has

NewsReport "0..*" --> "1" User : written by

class NewsSystem {
    + addReport(NewsReport)
    + removeReport(NewsReport)
    ..
    + search(options: Dict): List<NewsReport>
    ..
    + updateTitle(NewsReport, String)
    + updateContent(NewsReport, String)
    ..
    + publish(NewsReport)
    + unpublish(NewsReport)
    ..
    + addTag(NewsReport, ReportTag)
    + removeTag(NewsReport, ReportTag)
}

class UserSystem {
    + registerUser(User)
    + loginUser(email, password): User
    ..
    + search(options: Dict): List<User>
    ..
    + updatePassword(User, String, String)
    + updatePersonalInformations(User, Dict)
    + updatePreferences(User, Dict)
    ..
    + lock(User)
    + unlock(User)
    + delete(User)
}

class TagSystem {
    + addTag(tag: ReportTag)
    + removeTag(tag: ReportTag)
}

UserSystem --> "0..*" User : manages
NewsSystem --> "0..*" NewsReport : manages
TagSystem --> "0..*" ReportTag : manages

@enduml