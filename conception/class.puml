@startuml
skinparam classAttributeIconSize 0

class Reporter {
  - id: int
  - name: string
  - email: string
  - password: hash
  - isLocked: boolean
  + register()
  + login()
  + updateProfile()
  + deleteAccount()
}

class Administrator {
  + lockReporter(reporterID)
  + unlockReporter(reporterID)
  + removeReporter(reporterID)
  + viewStats()
}

class Article {
  - id: int
  - title: string
  - content: text
  - date: datetime
  - isPublished: boolean
  - viewCount: int
  + create()
  + update()
  + publish()
  + unpublish()
  + delete()
  + incrementView()
}

class Tag {
  - id: int
  - label: string
}

' Relations
Reporter "1" -- "0..*" Article : creates >
Article "0..*" -- "1..*" Tag : categorized by >
Administrator -- Reporter : manages >

note right of Tag : Pre-defined list:\nEducation, Science, Health,\nPolitics, etc.

@enduml