<nav class="navbar">
    <div class="navbar-left">
        <a href="{{ path('app_home') }}" class="navbar-brand">IMTox</a>
        <a href="{{ path('app_stats') }}" class="navbar-link">📊 Statistics</a>
        <a href="{{ path('app_admin_users') }}" class="navbar-link">🔧 Users</a>
        <a href="{{ path('app_admin_tag_index') }}" class="navbar-link">🔧 Tags</a>
    </div>
    <div class="navbar-center">
        <form action="{{ path('app_search') }}" method="get" class="search-form">
            <select name="search_type" aria-label="Filter search type">
                <option value="" {% if app.request.query.get('search_type') == '' %}selected{% endif %}>All</option>
                <option value="articles" {% if app.request.query.get('search_type') == 'articles' %}selected{% endif %}>Articles</option>
                <option value="reporters" {% if app.request.query.get('search_type') == 'reporters' %}selected{% endif %}>Reporters</option>
            </select>
            
            <input type="search" name="search" placeholder="Search..." aria-label="Search" value="{{ app.request.query.get('search', '') }}">
            
            <button type="submit" aria-label="Submit search">
                🔍
            </button>
        </form>
    </div>
    <div class="navbar-right">
        {% if true %}
            <a href="{{ path('app_my_account') }}" class="navbar-link" aria-label="Account">👤 My Account</a>
            <a href="{{ path('app_user_signout') }}" class="btn btn-primary" aria-label="Logout">↩ Sign Out</a>
        {% else %}
            <a href="{{ path('app_home') }}" class="btn btn-primary">Sign In / Sign Up</a> {# Replace with the actual sign-in route #}
        {% endif %}
    </div>
</nav>