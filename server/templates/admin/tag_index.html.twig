{% extends 'base.html.twig' %}

{% block title %}Manage Tags{% endblock %}

{% block body %}
    {% if is_admin %}

        <h1>Manage Tags</h1>

        <a class="btn-primary" href="{{ path('app_admin_tag_add') }}">+ Add New Tag</a>

        <div class="tags">
            {% for tag in tags %}
                <div class="tag">
                    <h2>{{ tag.name }}</h2>

                    <div class="tag-actions">
                        {% include "admin/_tag_edit_form.html.twig" %}
                        {% include "admin/_tag_delete_form.html.twig" %}
                    </div>
                </div>
            {% endfor %}
        </div>

    {% else %}
        {% include "admin/_not_authorized.html.twig" %}
    {% endif %}
{% endblock %}