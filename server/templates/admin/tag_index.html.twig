{% extends 'base.html.twig' %}

{% block title %}Manage Tags{% endblock %}

{% block body %}
<h1>Manage Tags</h1>

<a href="{{ path('app_admin_tag_add') }}">+ Add New Tag</a>

<div class="tags">
    {% for tag in tags %}
        <div class="tag">
            <h2>{{ tag.name }}</h2>
            <a href="{{ path('app_admin_tag_edit', {'id': tag.id}) }}">Edit</a>
            {% include "admin/_tag_delete_form.html.twig" %}   
        </div>
    {% endfor %}
</div>
{% endblock %}