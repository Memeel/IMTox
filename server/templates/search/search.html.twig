{% extends 'base.html.twig' %}

{% block title %}Search{% endblock %}

{% block body %}
<style> 
    table { width: 100%; border-collapse: collapse; margin-top: 20px; } 
    th, td { border: 1px solid #ccc; padding: 8px; text-align: left; } 
    th { background: #f0f0f0; } button { margin-right: 5px; } 
</style>

<div class="search-results">
    <h1>Search Results for "{{ app.request.query.get('search') }}"</h1>

    <form method="get" action="{{ path('app_search') }}">
        <div class="filters">
            <input type="text" name="search" placeholder="Search..." value="{{ app.request.query.get('search') }}">

            <select name="search_type">
                <option value="">All</option>
                <option value="articles" {% if app.request.query.get('search_type') == 'articles' %}selected{% endif %}>Articles</option>
                <option value="reporters" {% if app.request.query.get('search_type') == 'reporters' %}selected{% endif %}>Reporters</option>
            </select>

            <button type="submit">Filter</button>
        </div>
    </form>

    {% if articlesCount > 0 %}
        <h2>Articles ({{ articlesCount }})</h2>
        <table>
            <tr> 
                <th>Title</th>
                <th>Author</th>
                <th>Date</th>
                <th>Views</th>
            </tr>
            {% for article in articles %}
            <tr>
                <td><a href="{{ path('show_report', {'id': article.id}) }}">{{ article.title }}</a></td>
                <td>{{ article.author.username ?? 'Unknown' }}</td>
                <td>{{ article.createdAt ? article.createdAt|date('d/m/Y') : '' }}</td>
                <td>{{ article.numberOfViews ?? 0 }}</td>
            </tr>
            {% endfor %}
        </table>
    {% else %}
        <p>No articles found.</p>
    {% endif %}

    {% if reportersCount > 0 %}
        <h2>Reporters ({{ reportersCount }})</h2>
        <table>
            <tr> 
                <th>Name</th>
                <th>Email</th>
            </tr>
            {% for reporter in reporters %}
            <tr>
                <td>{{ reporter.fullname }}</td>
                <td>{{ reporter.mail }}</td>
            </tr>
            {% endfor %}
        </table>
    {% else %}
        <p>No reporters found.</p>
    {% endif %}

{% endblock %}