{# Auteurs: Sadok LAJMI, Mélina WANG #}
{{ form_start(form, {'attr': {'class': 'article-form'}}) }}
   
    {{ form_row(form.title) }}
    {{ form_row(form.tag) }}
    {{ form_row(form.content) }}

    <input type="hidden" name="_token" value="{{ csrf_token('create_edit' ~ news_report.id) }}">

    <div class="article-form-actions">
        <button class="article-btn article-btn-cancel" type="button" onclick="window.location.href='{{ path('show_articles', {'state': 'draft'}) }}'">Cancel</button>
        <button class="article-btn article-btn-draft" type="submit" name="save_action" value="draft">Save as Draft</button>
        <button class="article-btn article-btn-publish" type="submit" name="save_action" value="publish">Publish</button>
    </div>
{{ form_end(form) }}
