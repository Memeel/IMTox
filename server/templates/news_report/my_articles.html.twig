{% extends 'base.html.twig' %}

{% block title %}My Articles{% endblock %}

{% block body %}
    <nav class="nav-my-articles">
        {% set authorId = app.session.get('id') %}

        <div class="nav-top">
            <h1 class="logo">My Articles</h1>
            <a class="create" href="{{ path('create_report') }}">+ Create a new article</a>
        </div>

        {% set warnings = app.flashes('warning') %}
        {% if warnings|length > 0 %}
            <div>
                {{ warnings|last }}
            </div>
        {% endif %}

        <div class="nav-links">
            {% if authorId %}
                <a href="{{ path('show_articles', { 'state': 'draft', 'authorId': authorId }) }}">Drafts</a>
                <a href="{{ path('show_articles', { 'state': 'published', 'authorId': authorId }) }}">Published</a>
            {% else %}
                <a href="{{ path('app_user_login') }}">Drafts</a>
                <a href="{{ path('app_user_login') }}">Published</a>
            {% endif %}
        </div>
    </nav>

    <div>
        {% for news_report in news_reports %}
            <div class="article-card">
                <div class="article-header">
                    <h3>{{ news_report.title }}</h3>
                    <div class="actions">
                        <a class="view" href="{{ path('show_report', {'id': news_report.id}) }}">View</a>
                        <a class="modify" href="{{ path('edit_report', {'id': news_report.id}) }}">Modify</a>
                        {% if state == 'published' %}
                        <a class="publish" href="{{ path('change_state', {'id': news_report.id, 'state': 'draft'}) }}">Unpublish</a>
                        {% endif %}
                        {% if state == 'draft' %}
                        <a class="publish" href="{{ path('change_state', {'id': news_report.id, 'state': 'published'}) }}">Publish</a>
                        {% endif %}
                    </div>
                </div>

                <div class="meta"> 
                    <span>created on: {{ news_report.createdAt ? news_report.createdAt|date('d/m/Y') : '' }}</span>
                </div>

                {{ news_report.content|length > 150 ? news_report.content|slice(0, 150) ~ '...' : news_report.content }}

                {% if state != 'published' %}
                    {{ include('news_report/_delete_form.html.twig') }}
                {% endif %}
            </div>
        {% else %}
            <p>
            {% if state == 'draft' %}
                No drafts
            {% else %}
                No published articles
            {% endif %} 
            found. <a href="{{ path('create_report') }}">Create your first article</a>
            </p>
        {% endfor %}
    </div>


{% endblock %}