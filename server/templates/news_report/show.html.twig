{% extends 'base.html.twig' %}

{% block title %}{{ news_report.title }}{% endblock %}

{% block body %}
<div class="container">

    {# Back link #}
    <div>
        <a href="{{ path('app_news_report_index') }}">← Back to Articles</a>
    </div>

    {# Category (optional if you have one) #}
    {% if news_report.category is defined %}
        <div class="category">
            {{ news_report.category }}
        </div>
    {% endif %}

    {# Title #}
    <h1>{{ news_report.title }}</h1>

    {# Meta info #}
    <div class="meta">
        <span>By {{ news_report.author.fullName ?? 'Unknown' }}</span>
        <span>• Published {{ news_report.publishedAt ? news_report.publishedAt|date('F j, Y') : '' }}</span>
        <span>• Last updated {{ news_report.updateAt ? news_report.updateAt|date('F j, Y') : '' }}</span>
    </div>

    {# Content #}
    <div class="content">
        {{ news_report.content|raw }}
    </div>

    {# Footer actions #}
    <div class="actions">
        <a href="{{ path('app_news_report_edit', {'id': news_report.id}) }}">Edit</a>
        {{ include('news_report/_delete_form.html.twig') }}
    </div>

</div>
{% endblock %}
