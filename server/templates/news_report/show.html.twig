{# Auteurs: Sadok LAJMI, Mélina WANG #}

{% extends 'base.html.twig' %}

{% block title %}{{ news_report.title }}{% endblock %}

{% block body %}
<div class="container">

    {# Title #}
    <h1>{{ news_report.title }}</h1>

    {# Report Tag #}
    <div class="tag">
        {{ news_report.tag.name }}
    </div>

    {# Meta info and views #}
    <div class="meta display-flex justify-content: space-between">
        <div>
            <span>By {{ news_report.author.fullName ?? 'Unknown' }}</span>
            <span>• Published {{ news_report.publishedAt ? news_report.publishedAt|date('F j, Y') : '' }}</span>
            <span>• Last updated {{ news_report.updateAt ? news_report.updateAt|date('F j, Y') : '' }}</span>
        </div>

        <div>
            <span>Views: {{ news_report.numberOfViews }}</span>
        </div>
    </div>

    {# Content #}
    <div class="content">
        {{ news_report.content|raw }}
    </div>

    {# Footer actions #}
    {% if app.session.get('id') == news_report.author.id %} 
    <div class="actions">
        <button class="modify" type="button" onclick="window.location.href='{{ path('edit_report', {'id': news_report.id}) }}'">Edit</button>
        <form method="post" action="{{ path('delete_report', {'id': news_report.id}) }}" onsubmit="return confirm('Are you sure you want to delete this article?');">
            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ news_report.id) }}">
            <button class="delete" type="submit">Delete</button>
        </form>
    </div>
    {% endif %}

</div>
{% endblock %}
