{% extends 'base.html.twig' %}

{% block title %}NewsReport index{% endblock %}

{% block body %}
    <h1>NewsReport index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Title</th>
                <th>Content</th>
                <th>CreatedAt</th>
                <th>PublishedAt</th>
                <th>UpdateAt</th>
                <th>NumberOfViews</th>
                <th>State</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for news_report in news_reports %}
            <tr>
                <td>{{ news_report.id }}</td>
                <td>{{ news_report.title }}</td>
                <td>{{ news_report.content }}</td>
                <td>{{ news_report.createdAt ? news_report.createdAt|date('Y-m-d H:i:s') : '' }}</td>
                <td>{{ news_report.publishedAt ? news_report.publishedAt|date('Y-m-d H:i:s') : '' }}</td>
                <td>{{ news_report.updateAt ? news_report.updateAt|date('Y-m-d H:i:s') : '' }}</td>
                <td>{{ news_report.numberOfViews }}</td>
                <td>{{ news_report.state }}</td>
                <td>
                    <a href="{{ path('app_news_report_show', {'id': news_report.id}) }}">show</a>
                    <a href="{{ path('app_news_report_edit', {'id': news_report.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="9">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_news_report_new') }}">Create new</a>
{% endblock %}
