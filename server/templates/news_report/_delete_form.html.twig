<div style="display: flex; justify-content: flex-end;">
    <form style="margin-top: 20px;" method="post" action="{{ path('delete_report', {'id': news_report.id}) }}" onsubmit="return confirm('Are you sure you want to delete this article?');">
        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ news_report.id) }}">
        <button class="delete">Delete</button>
    </form>
</div>