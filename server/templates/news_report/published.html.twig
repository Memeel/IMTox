{% extends 'base.html.twig' %}

{% block title %}My Published Articles{% endblock %}

{% block body %}

    {% include "/news_report/articles_header.html.twig" %}

    <div>
        {% for news_report in published_report %}
            <div class="article-card">
                <div class="article-header">
                    <h3>{{ news_report.title }}</h3>
                    <div class="actions">
                        <a class="view" href="{{ path('show_report', {'id': news_report.id}) }}">View</a>
                        <a class="modify" href="{{ path('edit_report', {'id': news_report.id}) }}">Modify</a>
                        <a class="publish" href="{{ path('change_state', {'id': news_report.id, 'state': 'draft'}) }}">Unpublish</a>
                    </div>
                </div>

                <div class="meta"> 
                    <span>published on: {{ news_report.publishedAt ? news_report.publishedAt|date('d/m/Y') : '' }}</span>
                    <span> {{ news_report.numberOfViews ?? 0 }} views</span>
                </div>

                {{ news_report.content|length > 150 ? news_report.content|slice(0, 150) ~ '...' : news_report.content }}
                {{ include('news_report/_delete_form.html.twig') }}
            </div>
        {% else %}
            <p>
            No published articles found. <a href="{{ path('create_report') }}">Create your first article</a>
            </p>
        {% endfor %}
    </div>


{% endblock %}