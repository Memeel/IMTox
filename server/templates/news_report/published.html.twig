{% extends 'base.html.twig' %}

{% block title %}NewsReport index{% endblock %}

{% block body %}
    <h1>My Articles</h1>
    <button class="btn"><a href="{{ path('create_report') }}">Create Article</a></button>

    {% include "/news_report/articles_header.html.twig" %}

    <div>
        {% for news_report in published_report %}
            <div>
                <h3>{{ news_report.title }}</h3>
                <div>
                    <span>{{ news_report.author.username ?? 'Unknown' }}</span>
                    <span>{{ news_report.createdAt ? news_report.createdAt|date('d/m/Y') : '' }}</span>
                    <span>{{ news_report.numberOfViews ?? 0 }} views</span>

                    <button class="btn-small"><a href="{{ path('show_report', {'id': news_report.id}) }}">View</a></button>
                    <button class="btn-small"><a href="{{ path('edit_report', {'id': news_report.id}) }}">Modify</a></button>
                    <button class="btn-small"><a href="{{ path('change_state', {'id': news_report.id, 'state': 'draft'}) }}">Unpublish</a></button>
                </div>
                {{ news_report.content|length > 150 ? news_report.content|slice(0, 150) ~ '...' : news_report.content }}
                {{ include('news_report/_delete_form.html.twig') }}
            </div>
        {% else %}
            <p>
            No published articles found. <a href="{{ path('create_report') }}">Create your first article</a>
            </p>
        {% endfor %}
    </div>


{% endblock %}