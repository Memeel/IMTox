{% extends 'base.html.twig' %}

{% block title %}Statistics{% endblock %}

{% block body %}
<script src="/lib/phpchart/js/jquery.min.js"></script>
<script src="/lib/phpchart/js/jquery.jqplot.min.js"></script>
<script src="/lib/phpchart/js/plugins/jqplot.barRenderer.min.js"></script>
<script src="/lib/phpchart/js/plugins/jqplot.categoryAxisRenderer.min.js"></script>

<link rel="stylesheet" href="/lib/phpchart/css/jquery.jqplot.css">
<style> 
    .stats-container {
        display: flex;
        gap: 20px; 
        margin-top: 20px;
    }

    table { 
        border-collapse: collapse; 
        width: 50%; 
    }

    th, td { 
        border: 1px solid #ccc; 
        padding: 8px; 
        text-align: left; 
    }

    th { background: #f0f0f0; }
</style>

<div>
    <h1>Statistics Dashboard</h1>

    <div class="stats-container">
        <!-- Top 5 Articles -->
        <div>
            <table>
                <tr>
                    <th>Rank</th>
                    <th>Title</th>
                    <th>Author</th>
                    <th>Total Views</th>
                </tr>
                {% for i in 0..articles|length - 1 %}
                <tr>
                    <td>{{ i + 1 }}</td>
                    <td>{{ articles[i].title }}</td>
                    <td>{{ articles[i].author.fullname }}</td>
                    <td>{{ articles[i].numberOfViews }}</td>
                </tr>
                {% endfor %}
            </table>
            <div id="articleChart" style="height:300px;"></div>
        </div>

        <!-- Top 5 Reporters -->
        <div>
            <table>
                <tr>
                    <th>Rank</th>
                    <th>Reporter</th>
                    <th>Articles</th>
                    <th>Total Views</th>
                </tr>
                {% for reporter in reporters %}
                <tr>
                    <td>{{ loop.index }}</td>
                    <td>{{ reporter['fullname'] }}</td>
                    <td>{{ reporter['numberOfArticles'] }}</td>
                    <td>{{ reporter['totalViews'] }}</td>
                </tr>
                {% endfor %}
            </table>
            <div id="reporterChart" style="height:300px;"></div>
        </div>
    </div>
</div>
<script>
    $(document).ready(function () {
        // Articles chart
        var articleData = {{ articleViews|raw }};
        var articleTicks = {{ articleTitles|raw }};

        var articlePlot = $.jqplot('articleChart', [articleData], {
            title: 'Top Articles by Views',
            seriesDefaults: {
                renderer: $.jqplot.BarRenderer
            },
            axes: {
                xaxis: {
                    renderer: $.jqplot.CategoryAxisRenderer,
                    ticks: articleTicks
                }
            }
        });

        // Reporters chart
        var reporterData = {{ reporterViews|raw }};
        var reporterTicks = {{ reporterNames|raw }};

        var reporterPlot = $.jqplot('reporterChart', [reporterData], {
            title: 'Top Reporters by Views',
            seriesDefaults: {
                renderer: $.jqplot.BarRenderer
            },
            axes: {
                xaxis: {
                    renderer: $.jqplot.CategoryAxisRenderer,
                    ticks: reporterTicks
                }
            }
        });
    });
</script>
{% endblock %}