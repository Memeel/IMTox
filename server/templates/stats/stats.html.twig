{% extends 'base.html.twig' %}

{% block title %}Statistics{% endblock %}

{% block body %}

<style> 
    .stats-container { 
        display: flex; 
        gap: 20px; 
        margin-top: 20px; 
    }

    .stats-container > div { 
        flex: 1;
        min-width: 0;
    }

    table { 
        border-collapse: collapse; 
        width: 100%;
    }

    th, td { 
        border: 1px solid #ccc; 
        padding: 8px; 
        text-align: left; 
    }

    th { 
        background: #f0f0f0; 
    }

    canvas { 
        max-width: 100%;
        margin-top: 20px; 
    }
</style>

<div>
    <h1>Statistics Dashboard</h1>

    <div class="stats-container">
        <div>
            <h2>Top Articles</h2>
            {# Article Statistics Table #}
            <table>
                <tr><th>Rank</th><th>Title</th><th>Author</th><th>Total Views</th></tr>
                {% for article in articles %}
                <tr>
                    <td>{{ loop.index }}</td>
                    <td>{{ article.title }}</td>
                    <td>{{ article.author.fullname }}</td>
                    <td>{{ article.numberOfViews }}</td>
                </tr>
                {% endfor %}
            </table>
            <canvas id="articleChart"></canvas>
        </div>

        <div>
            <h2>Top Reporters</h2>
            {# Reporter Statistics Table #}
            <table>
                <tr><th>Rank</th><th>Reporter</th><th>Articles</th><th>Total Views</th></tr>
                {% for reporter in reporters %}
                <tr>
                    <td>{{ loop.index }}</td>
                    <td>{{ reporter.fullname }}</td>
                    <td>{{ reporter.numberOfArticles }}</td>
                    <td>{{ reporter.totalViews }}</td>
                </tr>
                {% endfor %}
            </table>
            <canvas id="reporterChart"></canvas>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    // Articles Chart
    const articleCtx = document.getElementById('articleChart').getContext('2d');
    const articleChart = new Chart(articleCtx, {
        type: 'bar',
        data: {
            labels: {{ articles|map(a => a.title)|json_encode|raw }},
            datasets: [{
                label: 'Total Views',
                data: {{ articles|map(a => a.numberOfViews)|json_encode|raw }},
                backgroundColor: 'rgba(54, 162, 235, 0.7)',
                borderColor: 'rgba(54, 162, 235, 1)',
                borderWidth: 1
            }]
        },
        options: { responsive: true, plugins: { legend: { display: false } } }
    });

    // Reporters Chart
    const reporterCtx = document.getElementById('reporterChart').getContext('2d');
    const reporterChart = new Chart(reporterCtx, {
        type: 'bar',
        data: {
            labels: {{ reporters|map(r => r.fullname)|json_encode|raw }},
            datasets: [{
                label: 'Total Views',
                data: {{ reporters|map(r => r.totalViews)|json_encode|raw }},
                backgroundColor: 'rgba(255, 99, 132, 0.7)',
                borderColor: 'rgba(255, 99, 132, 1)',
                borderWidth: 1
            }]
        },
        options: { responsive: true, plugins: { legend: { display: false } } }
    });
</script>

{% endblock %}